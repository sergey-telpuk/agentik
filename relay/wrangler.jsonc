{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentik-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",

  // RELAY_ID names this deployment. The device signs it as part of
  // registration, so a signature captured here cannot be replayed against a
  // different relay. Override it per environment.
  "vars": {
    "RELAY_ID": "agentik-relay-dev"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE",
        "class_name": "DeviceRoom"
      }
    ]
  },

  // Per-source-IP limits. src/limits.ts documents every relay limit and
  // mirrors these values in SOURCE_RATE_LIMITS; keep the two in step.
  // namespace_id must be unique per Cloudflare account.
  "ratelimits": [
    {
      "name": "CONNECT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "REGISTER_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "migrations": [
    {
      "tag": "v1",
      // The SQLite-backed class is what the free plan offers. The relay
      // keeps no application history in it: routes live in memory and in
      // hibernation attachments only.
      "new_sqlite_classes": ["DeviceRoom"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
